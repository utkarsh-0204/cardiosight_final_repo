# =============================================================================
# CardioSight Backend Environment Configuration Template
# Copy this file to .env and adjust values if needed:
#   cp .env.example .env
# =============================================================================

# Port for the Node.js / Express API gateway (Default: 3000)
PORT=3000

# PostgreSQL Connection Settings
# Option 1: Connection string URI (Default recommended for local development)
DATABASE_URL=postgres://cardiosight:cardiosight@localhost:5432/cardiosight

# Option 2: Individual connection parameters (Used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGUSER=cardiosight
PGPASSWORD=cardiosight
PGDATABASE=cardiosight

# JWT Authentication Secret (Use any long random phrase for local testing)
JWT_SECRET=cardiosight_secure_jwt_local_secret_key_2026

# JWT Token Expiration
JWT_EXPIRES_IN=7d

# Machine Learning Service URL (Django ML Microservice running on port 8000)
ML_SERVER_URL=http://127.0.0.1:8000

# Allowed CORS Origins (Frontend Angular Dev Server)
CORS_ORIGINS=http://localhost:4200

# Optional: Default Administrator Credentials (Seeded by 'npm run db:seed')
ADMIN_EMAIL=admin@cardiosight.local
ADMIN_PASSWORD=Admin@12345
